{
    "manifest_version": 3,
    "name": "Wikipedia Link Cleaner",
    "version": "1.1.0",
    "description": "Wikipedia sayfalarındaki linkleri temizler ve okumayı kolaylaştırır.",
    "permissions": [
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "*://*.wikipedia.org/wiki/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.wikipedia.org/wiki/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "wiki-cleaner@yakupemre",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "minimum_chrome_version": "120",
    "action": {
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png",
            "48": "icons/48.png"
        },
        "default_title": "Wikipedia Link Cleaner Ayarları",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "96": "icons/96.png",
        "128": "icons/128.png"
    }
}
